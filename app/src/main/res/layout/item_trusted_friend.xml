<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#10253C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_trusted_friend_card">

        <!-- AVATAR -->
        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_avtar"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_avatar_dark_circle"
            android:padding="6dp"/>

        <!-- NAME + UPI -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rohan"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>

            <TextView
                android:id="@+id/tvUpiId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9876543210@okicici"
                android:textSize="12sp"
                android:textColor="#9FB0C3"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- RISK BADGE -->
        <TextView
            android:id="@+id/tvRiskLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOW RISK"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_risk_low_dark"
            android:textColor="@android:color/white"/>

        <!-- 3 DOTS MENU -->
        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_more_vert"
            android:layout_marginStart="10dp"
            app:tint="#8FA3B8"
            android:padding="2dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>