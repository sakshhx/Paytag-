<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer glow border ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#2200898E"/>
            <corners android:radius="40dp"/>
        </shape>
    </item>

    <!-- Inner gradient fill -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="0"
                android:startColor="#01A4A3"
                android:endColor="#0F5674"/>
            <corners android:radius="38dp"/>
        </shape>
    </item>

</layer-list>