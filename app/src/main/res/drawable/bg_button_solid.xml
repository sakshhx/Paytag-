<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3320E3C2"/>
            <corners android:radius="40dp"/>
        </shape>
    </item>

    <!-- main button -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#1ED7B5"
                android:endColor="#0FAE9F"/>

            <corners android:radius="38dp"/>

        </shape>
    </item>

</layer-list>