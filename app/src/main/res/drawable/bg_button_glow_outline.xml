<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- subtle glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#221ED7B5"/>
            <corners android:radius="40dp"/>
        </shape>
    </item>

    <!-- outline -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="rectangle">

            <solid android:color="#0D1B2A"/> <!-- match background -->

            <stroke
                android:width="1.2dp"
                android:color="#2AF5D4"/>

            <corners android:radius="38dp"/>

        </shape>
    </item>

</layer-list>